# Port untuk Express Backend Server
PORT=5000

# URL Frontend (Next.js) yang diizinkan untuk CORS
CORS_ORIGIN=http://localhost:3000

# Supabase (Opsional - jika tidak diset, otomatis menggunakan database lokal SQLite backend/data/wedding.db)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# PostgreSQL (Opsional - jika ingin menggunakan koneksi PostgreSQL langsung)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wedding_db
