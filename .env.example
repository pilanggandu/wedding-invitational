# ========================================================
# WEDDING INVITATIONAL - PRODUCTION CONFIGURATION (.env)
# ========================================================

# --------------------------------------------------------
# 1. SERVER & PORT SETTINGS
# --------------------------------------------------------
NODE_ENV=production

# Port internal untuk Backend Express
PORT=5022

# Port internal Backend yang dirujuk oleh Frontend Next.js rewrites
BACKEND_PORT=5022

# URL Domain Frontend yang diizinkan untuk CORS
CORS_ORIGIN=https://invitation.papergode.xyz

# URL Endpoint API publik yang diakses oleh Browser / Client
NEXT_PUBLIC_API_URL=https://invitation.papergode.xyz/api

# URL Endpoint API internal untuk server-side rendering (SSR) Next.js
INTERNAL_API_URL=http://localhost:5022/api

# --------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# --------------------------------------------------------
# Secret key untuk signing JWT token login admin (Ganti dengan string acak unik)
JWT_SECRET=wedding_super_secret_key_change_this_in_production_2026

# --------------------------------------------------------
# 3. DATABASE: POSTGRESQL (VPS)
# --------------------------------------------------------
# Ganti 'PasswordPostgresAnda' dengan password asli user postgres Anda
DATABASE_URL=postgresql://postgres:PasswordPostgresAnda@localhost:5432/wedding_db

# (Opsional) Parameter terpisah jika tidak menggunakan DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=PasswordPostgresAnda
# PGDATABASE=wedding_db

# --------------------------------------------------------
# 4. GOOGLE SINGLE SIGN-ON (SSO) ADMIN LOGIN (OPSIONAL)
# --------------------------------------------------------
# Biarkan kosong jika admin hanya login dengan username/password standar
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_SSO_ALLOWED_EMAILS=emailanda@gmail.com,pasangan@gmail.com

# --------------------------------------------------------
# 5. SUPABASE CLOUD DATABASE (OPSIONAL - HANYA JIKA PAKAI CLOUD)
# --------------------------------------------------------
# Kosongkan jika sudah menggunakan PostgreSQL lokal VPS di atas
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
