# ========================================================
# ENVIRONMENT CONFIGURATION: EXPRESS & SUPABASE
# ========================================================

# Port untuk server backend Express
PORT=5000

# URL dan Kunci API Supabase (Dapatkan di Dashboard Supabase: Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Opsional jika membutuhkan hak akses admin backend penuh:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# URL Frontend (Next.js) yang diizinkan untuk CORS
CORS_ORIGIN=http://localhost:3000

# URL Backend yang diakses oleh Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:5000/api
