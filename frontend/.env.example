# URL Express Backend API
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Tampilkan kredensial admin bawaan di halaman login saat debug
NEXT_PUBLIC_DEBUG=false

# Google Identity Services Web Client ID (buat di Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# (Opsional) Supabase Direct Access jika diaktifkan di frontend
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
